# --- Telegram (obligatoire) -------------------------------------------------
# Token donne par @BotFather a la creation du bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ton identifiant de conversation. Ecris un message au bot, puis ouvre
# https://api.telegram.org/bot<TON_TOKEN>/getUpdates et lis result[0].message.chat.id
TELEGRAM_CHAT_ID=123456789

# --- slot.report (optionnel les 24 premieres heures) ------------------------
# Cle liee au domaine, obtenue apres mise en place du lien dofollow.
SLOT_REPORT_API_KEY=

# --- Reglages (tous optionnels, valeurs par defaut indiquees) ---------------
# TIMEZONE=Europe/Paris
# NOTIFY_WEEKDAY=0          # 0 = lundi, 1 = mardi ... 6 = dimanche
# SEND_EXCEL=true           # joindre le classeur au recap
# BOOTSTRAP_BACKFILL=true   # importer l'historique dans l'Excel au 1er run
# EXCLUDED_PROVIDERS=       # slugs separes par des virgules
